node_modules/
dist/
*.log
.DS_Store

# Disposable agent working files. Agent definitions (.claude/agents/) and
# cached architecture summaries (.claude/notes/) are tracked on purpose.
.claude/scratch/

# The unit authoring service's working state (spec 108): the job queue, the
# credit ledger and downloaded .glb files, none of which belong in git. What
# does get committed is what Export writes into assets/units/.
.studio/

# The live database (spec 226). A developer's save file, not source: the schema
# is in src/server/persistence/migrations.ts and is what gets reviewed. WAL and
# shared-memory sidecars go with it.
data/
*.db
*.db-wal
*.db-shm

# The raw audio takes (spec 229). 51.6 MB of 96kHz 24-bit production WAVs,
# and the same rule `.studio/` follows: the raw intermediate is not the
# deliverable. What gets committed is what `npm run bake:audio` writes into
# public/audio/. The takes live on the raw-audio-files branch.
assets/audio/raw/
