    "balance": "tsx scripts/balance-builds.ts"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "lil-gui": "^0.21.0",
    "pure-rand": "^6.1.0",
    "three": "^0.160.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.160.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.18.0",
    "fast-check": "^3.23.2",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
