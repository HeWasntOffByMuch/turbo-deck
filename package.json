{
  "name": "turbo-deck",
  "version": "0.0.1",
  "private": true,
  "description": "Action-roguelite with a deckbuilding layer: deterministic sim + thin renderer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:units": "tsx scripts/validate-units.ts",
    "validate:items": "tsx scripts/validate-items.ts",
    "bake:units": "tsx scripts/bake-units.ts",
    "build": "vite build",
    "dev": "vite",
    "server": "tsx src/server/index.ts",
    "server:bots": "tsx scripts/server-bot.ts",
